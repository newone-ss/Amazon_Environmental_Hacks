# ──────────────────────────────────────────────
# Bhujal — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# AWS
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=
S3_BUCKET_DATA=bhujal-data
S3_BUCKET_UPLOADS=bhujal-uploads
S3_BUCKET_FRONTEND=bhujal-frontend
DYNAMODB_TABLE_OBSERVATIONS=bhujal-observations
API_GATEWAY_URL=

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=ap-south-1

# Google Earth Engine (optional, for pipeline)
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# Dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
