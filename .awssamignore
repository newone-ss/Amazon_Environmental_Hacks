# Ignore CSV files (large datasets not needed at runtime)
data/*.csv

# Ignore reports directory (generated at runtime)
data/reports/

# Ignore Python cache directories
__pycache__
**/__pycache__

# Ignore version control
.git
.gitignore

# Ignore temporary files
*.tmp
*.temp

# Ignore IDE files
.vscode
.idea

# Ignore packaging files
.dist
build
*.egg-info

# Ignore test cache
.pytest_cache
.mypy_cache
.ruff_cache

# Ignore local environment
.venv
venv

# Ignore environment file (should be set via AWS Secrets Manager or Lambda env)
.env
.env.local

# Ignore logs
*.log

# Ignore notebooks
*.ipynb